{
  "name": "pion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/sync-csp.mjs && tsc --noEmit && vite build",
    "desktop": "node scripts/sync-csp.mjs && tauri dev",
    "desktop:build": "node scripts/sync-csp.mjs && tauri build",
    "test": "node --experimental-strip-types --test-concurrency=1 --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:pi": "node scripts/pi-smoke.mjs",
    "test:sessions": "node scripts/pi-session-smoke.mjs",
    "create-plugin": "node scripts/create-plugin.mjs",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "check:format": "prettier --check . && node scripts/check-format.mjs && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
