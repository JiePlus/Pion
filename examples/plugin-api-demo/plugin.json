{
  "id": "plugin-api-demo",
  "name": "Plugin API Demo",
  "nameI18n": { "zh-CN": "插件 API 示例" },
  "version": "0.1.0",
  "apiVersion": "1",
  "minDesktopVersion": "0.1.0",
  "main": "index.js",
  "permissions": ["workspace.read", "workspace.write", "network.fetch", "storage"],
  "access": {
    "workspaceWrite": ["pion-plugin-demo.md", "plugin-demo/**"],
    "network": ["example.com"]
  },
  "contributes": {
    "commands": [
      {
        "id": "plugin-api-demo.write",
        "title": "Write demo file",
        "titleI18n": { "zh-CN": "写入示例文件" }
      },
      {
        "id": "plugin-api-demo.fetch",
        "title": "Fetch example.com",
        "titleI18n": { "zh-CN": "请求 example.com" }
      },
      { "id": "plugin-api-demo.echo", "title": "Echo input", "titleI18n": { "zh-CN": "回显输入" } }
    ],
    "panels": [
      {
        "id": "plugin-api-demo.panel",
        "title": "Plugin API demo",
        "titleI18n": { "zh-CN": "插件 API 示例" },
        "location": "mainPanel"
      }
    ]
  }
}
